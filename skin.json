    "Badges for Contributors": {
      "description": "Display special badges for theme contributors on their profiles",
      "default": "yes",
      "tab": "General",
	  "section": "Contributors",
      "values": {
        "no": {},
        "yes": {
          "TargetJs": {
            "affects": ["^.*$", ".*"],
            "src": "Credits/Badges for Contributors.js"
          }
        }
      }
    },

