  "Conditions": {
    "Badges for Contributors": {
      "description": "Shows badges next to the names of Boosty supporters and people who helped with the theme (bug reports, fixes, ideas). Only people who use NEVKO-UI see them",
      "default": "yes",
      "tab": "General",
	  "section": "Contributors",
      "values": {
        "no": {},
        "yes": {
          "TargetJs": {
            "affects": ["^.*$", ".*"],
            "src": "Credits/Badges for Contributors.js"
          }
        }
      }
    },

    "Rounding Avatars": {
      "description": "How round avatars are across Steam, from square to a full circle",
      "default": "",
