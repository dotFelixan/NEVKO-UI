{
  "name": "NEVKO-UI REWRITE",
  "version": "1.0.0",
  "description": "Another Design for Steam",
  "author": "dotFelixan",

  "RootColors": "Patches/Colors/root.css",

  "github": {
    "owner": "dotFelixan",
    "repo_name": "NEVKO-UI"
  },

  "funding": { "boosty": "dotfelixan" },
  "discord_support": { "inviteCodeExcludingLink": "UuAQWZ9HxE" },

  "header_image": "https://i.imgur.com/2aRCvrt.png",
  "splash_image": "https://i.imgur.com/dqCDCH2.png",
  "tags": ["Customizable", "Features", "Accents"],

  "Conditions": {

			"DRIVER = 1": {
			  "description": "",
			  "default": "",
			  "tab": "General",
			  "values": { "": {} }
			},
	"Rounding Avatars": {
      "description": "Change how round or sharp avatars look throughout Steam",
      "default": "",
      "tab": "General",
      "values": { "": {} }
    },
    "Alternative Online Indicator": {
      "description": "Replaces default indicator with a modern dot-style badge (like Discord)",
      "default": "yes",
      "tab": "General",
      "values": {
        "no": {
          "TargetCss": {
            "affects": ["^Steam$"],
            "src": "Features/Status Indicator/Legacy Status Indicator.css"
			}
          },
        "yes": {
          "TargetCss": {
            "affects": ["^Steam$"],
            "src": "Features/Status Indicator/Modern Status Indicator.css"
          }
        }
      }
    },
	
			"DRIVER = 89": {
			  "description": "",
			  "default": "",
			  "tab": "UI Personalization",
			  "values": { "": {} }
			},
	"Rounding Buttons": {
      "description": "Change how round or sharp buttons look throughout Steam",
      "default": "",
      "tab": "UI Personalization",
      "values": { "": {} }
    },
	
			"DRIVER = 2": {
			  "description": "",
			  "default": "",
			  "tab": "UI Personalization",
			  "values": { "": {} }
			},
	"Reorder Main Buttons": {
      "description": "Swap the positions of 'Store' and 'Library' buttons in the header",
      "default": "yes",
      "tab": "UI Personalization",
      "values": {
        "no": {},
        "yes": {
          "TargetCss": {
            "affects": ["^Steam$"],
            "src": "Main Design/Header/Reorder Buttons.css"
          }
        }
      }
    },
    "Hide Profile Button": {
      "description": "Remove the profile button from the left side | Useful buttons are moved to Account Menu",
      "default": "yes",
      "tab": "UI Personalization",
      "values": {
        "no": {},
        "yes": {
          "TargetCss": {
            "affects": ["^Steam$", "Menu$", "SuperNav$"],
            "src": "Main Design/Header/Compact Profile Button/Hide Profile Button.css"
          },
          "TargetJs": {
            "affects": ["Menu$", "SuperNav$"],
            "src": "Main Design/Header/Compact Profile Button/Profile Buttons in Account Menu.js"
          }
        }
      }
    },
    "Compact Manage Downloads Button": {
      "description": "PlaceHolder",
      "default": "no",
      "tab": "UI Personalization",
      "values": {
        "no": {},
        "yes": {
          "TargetCss": {
            "affects": ["^Steam$"],
            "src": "Main Design/Header/Compact Buttons/Compact Download Button.css"
          }
        }
      }
    },
    "Account Button Style": {
      "description": "PlaceHolder",
      "default": "Hide Balance",
      "tab": "UI Personalization",
      "values": {
        "Default": {},
        "Minimal": {
          "TargetCss": {
            "affects": ["^Steam$"],
            "src": "Main Design/Header/Account Button Style/Minimal.css"
          }
		},
        "Hide Balance": {
          "TargetCss": {
            "affects": ["^Steam$"],
            "src": "Main Design/Header/Account Button Style/Balance.css"
          }
		},
        "Hide Nickname": {
          "TargetCss": {
            "affects": ["^Steam$"],
            "src": "Main Design/Header/Account Button Style/Nickname.css"
          }
		},
        "Hide Both": {
          "TargetCss": {
            "affects": ["^Steam$"],
            "src": "Main Design/Header/Account Button Style/Balance and Nickname.css"
          }
        }
      }
    },
	
			"DRIVER = 88": {
			  "description": "",
			  "default": "",
			  "tab": "Privacy",
			  "values": { "": {} }
			},
	"Blur Account Name": {
      "description": "Apply blur effect to your account/login name",
      "default": "no",
      "tab": "Privacy",
      "values": {
        "no": {},
        "yes": {
          "TargetCss": {
            "affects": [".*"],
            "src": "Features/Privacy/Login Account.css"
          }
        }
      }
    },
    "Blur Balance": {
      "description": "Apply blur effect to your wallet balance",
      "default": "no",
      "tab": "Privacy",
      "values": {
        "no": {},
        "yes": {
          "TargetCss": {
            "affects": ["Menu$", "SuperNav$"],
            "src": "Features/Privacy/Balance in Menu.css"
          }
        }
      }
    }

  },
  
  "UseDefaultPatches": true,
  "Patches": [
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "Main Design/Header/Header Code.css"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "Main Design/Header/Header Scripts.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "Main Design/Settings/Millennium/Quick Settings.css"
    },
	
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "Features/Custom Roundness Avatars/Custom Avatars.js"
    },
	
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "Features/Custom Border Radius/Buttons.css"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "Features/Custom Border Radius/Buttons.js"
    },
	
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "Main Design/Header/Compact Buttons/Compact Top Buttons.css"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "Main Design/Header/Compact Buttons/Fix Placement Buttons.js"
    },
	
	{
      "MatchRegexString": "^Steam$",
      "TargetJs": "Patches/STEAM Button Patch/STEAM Button Patch.js"
    },
	
	{
      "MatchRegexString": "^Steam$",
      "TargetCss": "Patches/Colors/Accents/Accents Code.css"
    },
	{
      "MatchRegexString": "^Steam$",
      "TargetCss": "Patches/Colors/Accents/Accents Elements.css"
    },
	
	{
      "MatchRegexString": "^Steam$",
      "TargetCss": "Patches/Legacy Style Tooltips/Legacy Tooltip.css"
    },
	
	{
      "MatchRegexString": "^Steam$",
      "TargetCss": "Patches/Colors/Backgrounds/Backgrounds Code.css"
    },
	{
      "MatchRegexString": "^Steam$",
      "TargetCss": "Patches/Colors/Backgrounds/Backgrounds Elements.css"
    },
	
	{
      "MatchRegexString": "^Steam$",
      "TargetJs": "Patches/WIP Badges for Settings/WIP Badges.js"
    },
	{
      "MatchRegexString": "^Steam$",
      "TargetJs": "Patches/Driver Settings/Driver.js"
    }
  ]
}
